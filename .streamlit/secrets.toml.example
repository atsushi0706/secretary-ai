# このファイルを secrets.toml にコピーして、自分の情報を入れてください。
# Gemini APIキー → https://aistudio.google.com/apikey で無料取得

GEMINI_API_KEY = "ここにGemini APIキーを貼る"

# 使うモデル(任意)。3系が使えるようになったらここを書き換えるだけ。
GEMINI_MODEL = "gemini-2.5-flash-lite"

# Zoom文字起こしが溜まるDriveルートフォルダID（任意。zoom-notebooklm-workflow と共有する時のみ）
# DRIVE_ROOT_FOLDER_ID = "..."

# 仕事用Gmailアカウント
WORK_EMAIL = "your-work-email@gmail.com"

# ntfy.sh のトピック名（スマホ通知用。推測されない長めの名前にする）
NTFY_TOPIC     = "your-unique-topic-name"
NTFY_CLICK_URL = "http://localhost:8501/"   # 通知タップ時に開くURL

# 公開URLにアクセスする時の合言葉（Streamlit Cloud 公開時のみ）
# APP_PASSWORD = "好きな合言葉"

# cron-job.org など外部cronから /?notify=... を叩く時の認証鍵（Cloud時のみ）
# NOTIFY_KEY   = "ランダム32文字"

# Streamlit Cloud にデプロイする時のみ、ローカルの token JSON をここに貼る
# [google_tokens]
# main = '''{...token_main.jsonの中身...}'''
# work = '''{...token_work.jsonの中身...}'''
